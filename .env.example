# Copy to .env.local for local development. Never commit real values.

# Password for the /admin area (choose a long one).
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (32+ random characters).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Where share links are stored: pick ONE of the two options below.

# Option A: PostgreSQL (for example a `business_plan` database on your existing RDS instance).
# The app creates its own table `business_plan_links` on first use.
DATABASE_URL=
# RDS requires SSL; set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Option B: DynamoDB table (partition key: token, type String).
LINKS_TABLE=
LINKS_REGION=eu-central-1

# With neither set, links go to .data/links.json (local development only).

# Optional. Public origin used when building share URLs in the admin list.
PUBLIC_BASE_URL=
