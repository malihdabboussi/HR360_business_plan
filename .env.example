# Copy to .env.local for local development. Never commit real values.

# Password for the /admin area (choose a long one).
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (32+ random characters).
SESSION_SECRET=change-me-to-a-long-random-string

# DynamoDB table that stores the share links (partition key: token, type String).
# Leave empty locally to use the file store in .data/links.json.
LINKS_TABLE=
LINKS_REGION=eu-central-1

# Optional. Public origin used when building share URLs in the admin list.
# Leave empty to use the request's own origin.
PUBLIC_BASE_URL=
